# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*




# Cache files for the editor to use
**/DerivedDataCache/*
**/Binaries/*
**/Intermediate/*

/SkyraDeps/AsyncMixin/Intermediate
/SkyraDeps/AsyncMixin/Binaries
/SkyraDeps/CommonGame/Intermediate
/SkyraDeps/CommonGame/Binaries
/SkyraDeps/CommonLoadingScreen/Intermediate
/SkyraDeps/CommonLoadingScreen/Binaries
/SkyraDeps/CommonUser/Binaries
/SkyraDeps/CommonUser/Intermediate
/SkyraDeps/GameplayMessageRouter/Intermediate
/SkyraDeps/GameplayMessageRouter/Binaries
/SkyraDeps/GameSettings/Intermediate
/SkyraDeps/GameSettings/Binaries
/SkyraDeps/GameSubtitles/Binaries
/SkyraDeps/GameSubtitles/Intermediate
/SkyraDeps/ModularGameplayActors/Intermediate
/SkyraDeps/ModularGameplayActors/Binaries
/SkyraDeps/UIExtension/Binaries
/SkyraDeps/UIExtension/Intermediate


